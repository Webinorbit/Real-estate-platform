generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  SUPER
  OWNER
  ADMIN
  BROKER
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PENTHOUSE
  PLOT
  COMMERCIAL
  STUDIO
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
}

enum TourKind {
  PANORAMA
  EXTERNAL
}

enum HotspotType {
  LINK
  INFO
}

enum LeadSource {
  ENQUIRY
  TOUR_BOOKING
  CALLBACK
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING
  NEGOTIATION
  WON
  LOST
}

enum RoutingStrategy {
  ROUND_ROBIN
  LEAST_LOADED
  WEIGHTED
  LISTING_AGENT
}

enum AssignmentKind {
  INITIAL
  REASSIGN
  ESCALATE
  MANUAL
}

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  customDomain    String?  @unique
  plan            Plan     @default(STARTER)
  active          Boolean  @default(true)
  tagline         String?
  about           String?
  logoUrl         String?
  heroImageUrl    String?
  heroVideoUrl    String?
  primaryColor    String   @default("#0f766e")
  accentColor     String   @default("#f59e0b")
  fontHeading     String   @default("playfair")
  fontBody        String   @default("inter")
  currency        String   @default("INR")
  locale          String   @default("en-IN")
  areaUnit        String   @default("sq ft")
  contactEmail    String?
  contactPhone    String?
  whatsapp        String?
  address         String?
  socials         Json?
  mapLat          Float    @default(19.076)
  mapLng          Float    @default(72.8777)
  mapZoom         Float    @default(11)
  analyticsSiteId String?
  webhookUrl      String?
  slaMinutes      Int      @default(15)
  maxReassigns    Int      @default(2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  brokers       Broker[]
  properties    Property[]
  tours         Tour[]
  scenes        Scene[]
  hotspots      Hotspot[]
  leads         Lead[]
  activities    LeadActivity[]
  assignments   Assignment[]
  rules         RoutingRule[]
  savedSearches SavedSearch[]
  favorites     Favorite[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  email        String
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broker       Broker?

  @@unique([tenantId, email])
}

model Broker {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String?   @unique
  name           String
  email          String
  phone          String?
  photoUrl       String?
  title          String?
  bio            String?
  languages      String[]  @default([])
  specialties    String[]  @default([])
  areas          String[]  @default([])
  territory      Json?
  capacity       Int       @default(15)
  weight         Int       @default(1)
  active         Boolean   @default(true)
  timezone       String    @default("Asia/Kolkata")
  workingHours   Json?
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties  Property[]
  leads       Lead[]
  assignments Assignment[]

  @@index([tenantId, active])
}

model Property {
  id              String         @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  description     String         @default("")
  listingType     ListingType    @default(SALE)
  type            PropertyType   @default(APARTMENT)
  status          PropertyStatus @default(ACTIVE)
  price           Float
  priceUnit       String?
  beds            Int            @default(0)
  baths           Int            @default(0)
  areaSqft        Float          @default(0)
  yearBuilt       Int?
  furnishing      String?
  parking         Int            @default(0)
  floor           Int?
  totalFloors     Int?
  facing          String?
  address         String         @default("")
  locality        String         @default("")
  city            String         @default("")
  state           String?
  postalCode      String?
  lat             Float
  lng             Float
  amenities       String[]       @default([])
  images          Json           @default("[]")
  videoUrl        String?
  featured        Boolean        @default(false)
  views           Int            @default(0)
  listingBrokerId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingBroker Broker?    @relation(fields: [listingBrokerId], references: [id], onDelete: SetNull)
  tours         Tour[]
  leads         Lead[]
  favorites     Favorite[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, lat, lng])
  @@index([tenantId, status, listingType, price])
  @@index([tenantId, featured])
}

model Tour {
  id           String   @id @default(cuid())
  tenantId     String
  propertyId   String
  title        String
  kind         TourKind @default(PANORAMA)
  externalUrl  String?
  floorPlanUrl String?
  planFloors   Json?
  published    Boolean  @default(false)
  autoRotate   Boolean  @default(true)
  startSceneId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  scenes   Scene[]

  @@index([tenantId, propertyId])
}

model Scene {
  id          String  @id @default(cuid())
  tenantId    String
  tourId      String
  name        String
  roomLabel   String?
  floor       Int     @default(0)
  panoramaUrl String
  thumbUrl    String?
  lat         Float?
  lng         Float?
  planX       Float?
  planY       Float?
  northYaw    Float   @default(0)
  initialYaw  Float   @default(0)
  order       Int     @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotspots Hotspot[] @relation("SceneHotspots")
  incoming Hotspot[] @relation("HotspotTarget")

  @@index([tourId, order])
}

model Hotspot {
  id            String      @id @default(cuid())
  tenantId      String
  sceneId       String
  type          HotspotType @default(LINK)
  yaw           Float
  pitch         Float       @default(0)
  label         String?
  content       String?
  targetSceneId String?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scene       Scene  @relation("SceneHotspots", fields: [sceneId], references: [id], onDelete: Cascade)
  targetScene Scene? @relation("HotspotTarget", fields: [targetSceneId], references: [id], onDelete: SetNull)

  @@index([sceneId])
}

model Lead {
  id              String     @id @default(cuid())
  tenantId        String
  propertyId      String?
  brokerId        String?
  source          LeadSource @default(ENQUIRY)
  name            String
  email           String
  phone           String?
  message         String?
  language        String?
  budget          Float?
  preferredAt     DateTime?
  status          LeadStatus @default(NEW)
  assignedAt      DateTime?
  firstResponseAt DateTime?
  slaDueAt        DateTime?
  escalated       Boolean    @default(false)
  reassignCount   Int        @default(0)
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker      Broker?        @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  activities  LeadActivity[]
  assignments Assignment[]

  @@index([tenantId, status])
  @@index([tenantId, brokerId, status])
  @@index([status, slaDueAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  type      String
  note      String?
  actor     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Assignment {
  id         String         @id @default(cuid())
  tenantId   String
  leadId     String
  brokerId   String?
  ruleId     String?
  ruleName   String?
  strategy   String?
  kind       AssignmentKind @default(INITIAL)
  reasons    Json?
  candidates Json?
  createdAt  DateTime       @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([leadId])
}

model RoutingRule {
  id               String          @id @default(cuid())
  tenantId         String
  name             String
  priority         Int             @default(100)
  enabled          Boolean         @default(true)
  conditions       Json            @default("{}")
  strategy         RoutingStrategy @default(ROUND_ROBIN)
  brokerIds        String[]        @default([])
  requireAvailable Boolean         @default(true)
  matchLanguage    Boolean         @default(false)
  useTerritory     Boolean         @default(false)
  slaMinutes       Int?
  createdAt        DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, priority])
}

model SavedSearch {
  id        String   @id @default(cuid())
  tenantId  String
  visitorId String
  name      String
  email     String?
  query     Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, visitorId])
}

model Favorite {
  id         String   @id @default(cuid())
  tenantId   String
  visitorId  String
  propertyId String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, visitorId, propertyId])
  @@index([tenantId, visitorId])
}
