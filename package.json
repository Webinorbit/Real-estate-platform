{
  "name": "webinorbit-realestate-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebInOrbit Real Estate Dynamic Platform: multi-tenant real estate SaaS with map search, virtual tours and a broker routing engine.",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/copy-vendor.mjs",
    "api:setup": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt",
    "api:dev": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "api:start": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:migrate": "cd backend && .venv/bin/python -m app.cli migrate",
    "db:seed": "cd backend && .venv/bin/python -m app.cli seed",
    "assets:demo": "node scripts/fetch-demo-assets.mjs",
    "tenant:create": "cd backend && .venv/bin/python -m app.cli tenant:create",
    "test": "cd backend && .venv/bin/python -m pytest -q"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "sharp": "^0.35.5"
  }
}
